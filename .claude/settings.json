{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-pr-title.py",
            "timeout": 10,
            "statusMessage": "Checking PR title is a Conventional Commit"
          }
        ]
      }
    ]
  }
}
